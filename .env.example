# Every environment variable the app and scripts read. Names only, no values.
# Copy to .env.local for local development; set the same names in Vercel.

# Auth.js v5 (read implicitly by next-auth, not via process.env in src/)
AUTH_SECRET=
# Optional: the app's origin when it can't be inferred (local dev uses http://localhost:3000)
AUTH_URL=
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=

# Firebase Admin SDK (server-only, never NEXT_PUBLIC_*)
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
# Paste with literal \n line breaks; src/shared/lib/firebase-admin.ts converts them
FIREBASE_PRIVATE_KEY=
FIREBASE_STORAGE_BUCKET=

# Stripe (test mode)
STRIPE_SECRET_KEY=
# Local dev: the whsec_... printed by `bun run stripe:listen`, which changes each session
STRIPE_WEBHOOK_SECRET=

# Portfolio demo sign-in: "true" shows the one-click demo buttons and enables the demo provider
DEMO_ACCESS_ENABLED=

# Optional: absolute site origin override for metadata (otherwise derived from Vercel's vars)
SITE_URL=

# Seed and local QA scripts only (scripts/seed-test-users.ts); not needed in Vercel
TEST_ADMIN_PASSWORD=
TEST_CUSTOMER_PASSWORD=

# Platform-provided, never set by hand: VERCEL_ENV, VERCEL_URL,
# VERCEL_PROJECT_PRODUCTION_URL (Vercel) and PORT (local server)
